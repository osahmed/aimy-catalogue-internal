{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/one-page-pitch",
      "destination": "/one-page-pitch.html"
    }
  ],
  "headers": [
    {
      "source": "/catalogue-public.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600"
        }
      ]
    }
  ]
}
