{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!aimy-catalogue-site/).*)",
      "destination": "/aimy-catalogue-site/$1"
    }
  ],
  "redirects": [
    {
      "source": "/one-page-pitch",
      "destination": "/aimy-catalogue-site/one-page-pitch.html",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/aimy-catalogue-site/catalogue-public.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600"
        }
      ]
    }
  ]
}
