# Atlassian Connection Details
ATLASSIAN_SITE=yoursite.atlassian.net
ATLASSIAN_EMAIL=your.email@company.com
ATLASSIAN_API_TOKEN=your_atlassian_api_token_here
ATLASSIAN_CLOUD_ID=your_cloud_id_here

# Confluence Configuration
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY
CONFLUENCE_SPACE_ID=your_space_id
CONFLUENCE_PARENT_ID=your_parent_page_id

# Jira Configuration
JIRA_PROJECT_KEY=YOUR_PROJECT

# AiMY Catalogue Content Details
AIMY_CATALOGUE_SOURCE=/path/to/your/source/file.md
AIMY_CATALOGUE_TITLE=Your Catalogue Title

# ============================================================
# AWS Cognito SSO Authentication (frontend + backend gating)
# ============================================================
# Cognito Hosted UI domain (no trailing slash)
COGNITO_DOMAIN=https://us-east-13ibxa3rel.auth.us-east-1.amazoncognito.com
# OIDC issuer = https://cognito-idp.<region>.amazonaws.com/<userPoolId>
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_3iBxA3reL
# App client id and secret (confidential client). NEVER commit the real secret.
COGNITO_CLIENT_ID=7qqsvrc3h0molhts9g0djemsvb
COGNITO_CLIENT_SECRET=your_cognito_app_client_secret_here
# Optional: force a specific federated corporate IdP (Cognito IdP name).
# Leave blank to show the Cognito Hosted UI chooser.
COGNITO_IDP_NAME=
# Public base URL of THIS deployment (no trailing slash).
# Local dev: http://localhost:3000
APP_BASE_URL=https://aimy-catalogue-internal-617r.vercel.app
# Secret used to sign the session cookie. Generate 32+ random bytes, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=generate_a_long_random_value_here
